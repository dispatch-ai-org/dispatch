{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatch.dev/schemas/routing-feedback-v1.json",
  "title": "Dispatch RoutingFeedbackV1",
  "description": "One immutable human feedback state change for an existing same-contributor routing observation. Field byte limits and privacy checks are additionally enforced by the server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "feedback_event_id", "observation_id", "contributor_id",
    "revision", "consent", "outcome", "reasons", "evaluated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "feedback_event_id": { "$ref": "#/$defs/identity" },
    "observation_id": { "$ref": "#/$defs/identity" },
    "contributor_id": { "$ref": "#/$defs/identity" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "enabled_at"],
      "properties": {
        "scope": { "const": "routing-observation-v1" },
        "enabled_at": { "type": "string", "format": "date-time" }
      }
    },
    "outcome": { "enum": ["accept", "reject"] },
    "reasons": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "explanation": { "type": ["string", "null"], "maxLength": 131072 },
    "evaluated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$" }
  }
}
