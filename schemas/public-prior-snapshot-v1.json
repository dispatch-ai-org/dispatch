{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rundispatch.sh/schemas/public-prior-snapshot-v1.json",
  "title": "PublicPriorSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "generated_at", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "dataset", "dataset_version", "harness", "model", "language", "task_kind", "scope", "successes", "attempts"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 256 },
          "dataset": { "type": "string", "minLength": 1, "maxLength": 256 },
          "dataset_version": { "type": "string", "minLength": 1, "maxLength": 256 },
          "harness": { "type": "string", "minLength": 1, "maxLength": 256 },
          "model": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
          "language": { "enum": ["rust", "python", "go", "cpp", null] },
          "task_kind": { "enum": ["bug_fix", "feature", "refactor", "tests", "unknown"] },
          "scope": { "enum": ["localized", "multi_file", "broad", "unknown"] },
          "successes": { "type": "integer", "minimum": 0 },
          "attempts": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
