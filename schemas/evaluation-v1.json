{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatch.dev/schemas/evaluation-v1.json",
  "title": "Dispatch EvaluationEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "contributor_id",
    "consent",
    "run",
    "task",
    "project",
    "baseline_verification",
    "candidates",
    "human_evaluation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evaluation_id": { "type": "string" },
    "contributor_id": { "type": "string" },
    "consent": { "$ref": "#/$defs/consent" },
    "run": { "$ref": "#/$defs/run" },
    "task": { "$ref": "#/$defs/task" },
    "project": { "$ref": "#/$defs/project" },
    "baseline_verification": { "$ref": "#/$defs/verification" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "human_evaluation": { "$ref": "#/$defs/human_evaluation" }
  },
  "$defs": {
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "enabled_at"],
      "properties": {
        "scope": { "const": "evaluation-v1" },
        "enabled_at": { "type": "string", "format": "date-time" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "status",
        "created_at",
        "completed_at",
        "dispatch_version",
        "os",
        "architecture",
        "execution_backend",
        "timeout_secs",
        "cpus",
        "memory",
        "resource_limits_enforced",
        "unsafe_local"
      ],
      "properties": {
        "run_id": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "completed_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "dispatch_version": { "type": "string" },
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "execution_backend": { "type": "string" },
        "timeout_secs": { "type": "integer", "minimum": 0 },
        "cpus": { "type": "number", "minimum": 0 },
        "memory": { "type": "string" },
        "resource_limits_enforced": { "type": "boolean" },
        "unsafe_local": { "type": "boolean" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source"],
      "properties": {
        "text": { "type": "string" },
        "source": { "type": ["string", "null"] }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "languages", "file_count"],
      "properties": {
        "source_type": { "enum": ["git", "git_worktree", "directory"] },
        "languages": {
          "anyOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" }
          ]
        },
        "file_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "label",
        "harness_id",
        "harness_version",
        "model",
        "status",
        "runtime_ms",
        "exit_code",
        "timed_out",
        "process_failure",
        "task_tokens",
        "token_semantics",
        "cost_usd",
        "files_changed",
        "lines_added",
        "lines_removed",
        "verification",
        "human_outcome"
      ],
      "properties": {
        "candidate_id": { "type": "string" },
        "label": { "type": "string" },
        "harness_id": { "type": "string" },
        "harness_version": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "runtime_ms": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "process_failure": { "type": "boolean" },
        "task_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "token_semantics": { "type": ["string", "null"] },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "files_changed": { "type": "integer", "minimum": 0 },
        "lines_added": { "type": "integer", "minimum": 0 },
        "lines_removed": { "type": "integer", "minimum": 0 },
        "verification": { "$ref": "#/$defs/verification" },
        "human_outcome": {
          "enum": ["selected", "not_selected", "tie", "neither"]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "checks"],
      "properties": {
        "state": { "enum": ["passed", "failed", "not_run", "not_configured"] },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "phase", "status", "exit_code", "duration_ms"],
      "properties": {
        "name": { "type": "string" },
        "phase": { "enum": ["baseline", "verify"] },
        "status": { "enum": ["passed", "failed", "timed_out", "not_run"] },
        "exit_code": { "type": ["integer", "null"] },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "human_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "selected_candidate",
        "reasons",
        "explanation",
        "blind",
        "created_at"
      ],
      "properties": {
        "outcome": { "enum": ["candidate", "tie", "neither"] },
        "selected_candidate": { "type": ["string", "null"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "explanation": { "type": ["string", "null"] },
        "blind": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
